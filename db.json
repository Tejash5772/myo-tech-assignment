      "key": "price",
      "control": "number",
      "label": "Price (INR)",
      "required": true,
      "min": 1
    },
    {
      "key": "stock",
      "control": "number",
      "label": "Stock",
      "required": true,
      "min": 0
    },
    {
      "key": "status",
      "control": "dropdown",
      "label": "Status",
      "required": true,
      "dependentOptions": {
        "": [
          {
            "label": "Active",
            "value": "Active"
          },
          {
            "label": "Inactive",
            "value": "Inactive"
          }
        ]
      }
    },
    {
      "key": "image",
      "control": "file",
      "label": "Product Image",
      "required": false
    },
    {
      "key": "inactiveReason",
      "control": "textarea",
      "label": "Inactive Reason",
      "requiredWhen": {
        "field": "status",
        "equals": "Inactive"
      },
      "hiddenWhen": {
        "field": "status",
        "equals": "Active"
      }
    }
  ]
